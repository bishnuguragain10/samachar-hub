# Database Configuration
DATABASE_URL=mysql://root:password@localhost:3306/samachar_hub

# Application Configuration
APP_ID=samachar-hub-dev
JWT_SECRET=your-jwt-secret-key-here
COOKIE_SECRET=your-cookie-secret-key-here

# OAuth Configuration (Optional for development)
OAUTH_SERVER_URL=https://auth.example.com
OWNER_OPEN_ID=your-owner-open-id

# Admin Configuration
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123
ADMIN_OPEN_ID=admin-open-id

# Development Admin
DEV_ADMIN_NAME=Development Admin
DEV_ADMIN_EMAIL=dev@localhost
DEV_ADMIN_OPEN_ID=dev-admin-user

# Built-in Forge API (Optional)
BUILT_IN_FORGE_API_URL=https://forge.example.com
BUILT_IN_FORGE_API_KEY=your-forge-api-key

# Server Configuration
PORT=3000
NODE_ENV=development
